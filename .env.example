# Environment: development | staging | production
ENVIRONMENT=development
DEBUG=false

# PostgreSQL 16 (РФ ЦОД по ч. 5 ст. 18 152-ФЗ)
POSTGRES_USER=tutors_app
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=tutors_db
DATABASE_URL=postgresql+asyncpg://tutors_app:change_me_strong_db_password@postgres:5432/tutors_db

# Redis (сессии refresh-токенов, TOTP state, кэш)
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
REDIS_PASSWORD=change_me_redis_password

# Криптография и токены (генерировать: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())")
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CSRF_SECRET_KEY=replace_with_at_least_32_random_bytes_csrf_secret

# Ключи защиты ПДн (152-ФЗ): AES-256-GCM (32 байта в base64url) и ключ blind-index HMAC-SHA256
PII_ENCRYPTION_KEY=replace_with_url_safe_base64_32_byte_aes256_key=
PII_BLIND_INDEX_KEY=replace_with_at_least_32_random_bytes_hmac_key

# Yandex Object Storage (S3-совместимое хранилище в РФ: ru-central1)
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET_DIPLOMAS=tutors-private-diplomas
S3_ACCESS_KEY_ID=replace_with_yc_access_key_id
S3_SECRET_ACCESS_KEY=replace_with_yc_secret_access_key
S3_PRESIGNED_TTL_SECONDS=300
DIPLOMA_MAX_SIZE_BYTES=10485760

# Доверенные CORS origins (JSON-список без '*')
CORS_ALLOWED_ORIGINS=["https://localhost","http://localhost:3000"]
COOKIE_SECURE=true
COOKIE_DOMAIN=localhost
